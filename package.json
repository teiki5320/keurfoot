{
  "name": "keurfoot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf out/actus/aucun-article out/actus/aucun-article.html out/actus/aucun-article.txt",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prebuild": "tsx scripts/epingles.mts && tsx scripts/images.mts && tsx scripts/articles.mts",
    "test:sortie": "NEXT_PUBLIC_SITE_URL=https://keurfoot.com NEXT_TELEMETRY_DISABLED=1 npm run build && npm run test:sortie:controle",
    "test:sortie:controle": "tsx --test tests/sortie/*.test.ts",
    "verifier-produits": "node scripts/verifier-produits.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "marked": "^16.4.2",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "1.63.0",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
