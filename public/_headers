# En-têtes de sécurité servis par Cloudflare (keurfoot.com) sur toutes les pages.
# CSP : scripts, styles et images du site (Next.js a besoin de scripts en ligne),
# plus le strict nécessaire pour Google AdSense et son bandeau de consentement (domaines Google seulement) ;
# teiki5320.github.io : fichier et images des actus (veille), en connect-src et img-src seulement ;
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.google.fr https://*.gstatic.com https://*.adtrafficquality.google https://teiki5320.github.io; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://cloudflareinsights.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google https://teiki5320.github.io; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fichiers de build versionnés : mis en cache longtemps.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images du site (noms stables) : cache d'une semaine.
/epingles/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/illustrations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/reduites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
