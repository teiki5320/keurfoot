# =====================================================================
# Keur Foot — variables d'environnement (toutes publiques, aucun secret)
# Copier ce fichier en .env.local pour le développement.
# En production, le site est construit par GitHub Actions
# (.github/workflows/deploy.yml) et publié sur keurfoot.com par un Worker
# de fichiers statiques Cloudflare (wrangler.jsonc, commande npx wrangler deploy).
# Les secrets de publication (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID)
# se règlent uniquement dans GitHub : Settings → Secrets and variables → Actions.
# =====================================================================

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Keur Foot
NEXT_PUBLIC_CONTACT_EMAIL=keurfoot@toakeur.com

# --- Programme Partenaires Amazon : identifiant ajouté aux liens « Acheter » (par défaut keurfootfr-21).
NEXT_PUBLIC_AMAZON_TAG=

# --- Informations légales (mentions légales, conditions d'utilisation)
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_PHONE=
# Hébergeur (par défaut : Cloudflare).
NEXT_PUBLIC_LEGAL_HOST=
NEXT_PUBLIC_LEGAL_HOST_NAME=

# --- Version provisoire (GitHub Pages) : sous-dossier du site et mode « non indexé » (1 = aucune page indexée).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_NOINDEX=

# --- Google AdSense : laisser vide pour retirer tout script Google (cas de la version provisoire).
# NEXT_PUBLIC_ADSENSE_CLIENT=
